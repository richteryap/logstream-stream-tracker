{
  "manifest_version": 3,
  "name": "LogStream",
  "version": "1.1",
  "browser_specific_settings": {
    "gecko": {
      "id": "logstream@local.dev"
    }
  },
  "description": "Manual Media Stream Tracker",
  "permissions": [
    "activeTab",
    "notifications"
  ],
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "host_permissions": [
    "http://127.0.0.1:5000/*",
    "http://localhost:5000/*",
    "https://*.ngrok-free.dev/*",
    "https://*.ngrok-free.app/*",
    "https://*.pythonanywhere.com/*"
  ]
}